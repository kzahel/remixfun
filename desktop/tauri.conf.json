{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remixfun",
  "version": "0.1.0",
  "identifier": "com.graehlarts.remixfun",
  "build": { "frontendDist": "../web/dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'" }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "externalBin": ["binaries/remixfun-service"],
    "resources": {"../dist/remixfun-service/_internal/": "_internal/"},
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
